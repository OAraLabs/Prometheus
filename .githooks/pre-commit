#!/usr/bin/env bash
#
# Pre-commit hook. Two guards, in order:
#   1. commits from the SHARED dev checkout are refused (worktrees only)
#   2. commits containing secrets, private IPs, or infrastructure-specific
#      data that shouldn't go public are blocked
#
# Install: git config core.hooksPath .githooks

set -euo pipefail

# ---------------------------------------------------------------------------
# Guard 1 — commit from a worktree, not from the shared checkout.
#
# Concurrent sessions share one tree, and it collides: a session switched the
# dev checkout to another branch mid-session and a second session's edits
# landed on it; a stray `git add` swept unrelated files into #183; stale
# stashes from unrelated contexts accumulate on main. None of it announced
# itself — the tree just quietly was not what the last command assumed.
#
# The deploy clone already proved the shape: it refuses commits outright
# (scripts/install-deploy-guards.sh) and that discipline has held. This is
# the same idea one step weaker — the dev checkout may still be committed
# from deliberately, but not by accident.
#
# WORKTREES ARE EXEMPT, which is the whole point. A linked worktree's
# --git-dir is .git/worktrees/<name> while --git-common-dir is .git; they are
# equal ONLY in the main checkout. (core.hooksPath is shared across every
# worktree, so without this test the guard would block the very workflow it
# exists to encourage.)
#
# ESCAPE HATCH, DELIBERATE AND VISIBLE
# ------------------------------------
# PROMETHEUS_ALLOW_DEV_COMMIT=1 permits the commit and records that it did —
# loudly on stderr, and durably as a Dev-checkout-override trailer added by
# .githooks/prepare-commit-msg. Same reasoning as
# PROMETHEUS_ALLOW_UNMERGED_DEPLOY in scripts/deploy_guard.sh: a guard with no
# override is one people disable wholesale the first time it blocks something
# legitimate (the --no-verify reflex), and an override that announces itself
# beats a guard that gets commented out. The trailer is the durable half —
# a hook's stderr scrolls away, whereas `git log --grep` finds the trailer
# months later.
# ---------------------------------------------------------------------------
_git_dir=$(git rev-parse --absolute-git-dir)
_common_dir=$(cd "$(git rev-parse --git-common-dir)" && pwd -P)

if [ "$_git_dir" = "$_common_dir" ]; then
    if [ "${PROMETHEUS_ALLOW_DEV_COMMIT:-0}" = "1" ]; then
        printf '\n' >&2
        printf 'pre-commit: OVERRIDE ACTIVE (PROMETHEUS_ALLOW_DEV_COMMIT=1)\n' >&2
        printf 'pre-commit: committing from the SHARED dev checkout, not a worktree.\n' >&2
        printf 'pre-commit: recorded as a Dev-checkout-override trailer on this commit.\n' >&2
        printf '\n' >&2
    else
        cat <<'MSG' >&2

=== COMMIT REFUSED — this is the shared dev checkout ===

  Other sessions share this tree. Committing here races them: the branch
  under you can change mid-session, and a stray `git add` picks up their
  files as well as yours.

  Work in a worktree instead — one per session:

      git -C "$(git rev-parse --show-toplevel)" worktree add \
          .claude/worktrees/<name> -b <branch> origin/main

  Your staged changes are safe. To move them across:

      git stash push -m <name> -- <paths you touched>
      # then, inside the new worktree:
      git stash pop

  Deliberately committing here anyway (rebases, hotfixes, solo work):

      PROMETHEUS_ALLOW_DEV_COMMIT=1 git commit ...

  That is allowed and recorded — it adds a Dev-checkout-override trailer to
  the commit rather than hiding the exception.

MSG
        exit 1
    fi
fi

BLOCKED=0

# Two scopes, because the dangerous classes and the noisy class differ.
#
# STAGED_ALL — everything except the hook itself (which necessarily contains
#   the patterns it hunts for). Prose is where a human pastes a token or an
#   address while explaining something, so markdown and docs/ ARE scanned for
#   credentials, private IPs, and key material. They were excluded until
#   2026-08-01, which is exactly how real tailnet IPs reached three tracked
#   files (skills/download-model-to-gpu.md, docs/PROMETHEUS-FULL.md,
#   docs/sprints/GRAFT-ROUTER-WIRE.md) in a public repo. GHAS generic scanning
#   is unavailable on this plan, so this hook is the only net — a net with a
#   hole over the most paste-prone files is not a net.
#
# STAGED_CODE — excludes markdown and docs/. Used ONLY for the broad
#   `OAra-|oara-` hostname check, which cannot run over prose without crying
#   wolf: legitimate repo and project names (oara-site, oara-voice) and the
#   package name (oara-prometheus) all match it, and a hook that cries wolf
#   trains you to reach for --no-verify. Hostnames are also the mildest class
#   here: MagicDNS names do not resolve outside the tailnet. IPs stay blocked
#   everywhere, which is the control that actually matters.
STAGED_ALL=$(git diff --cached --name-only --diff-filter=ACM | \
    grep -v '^\.githooks/' || true)

STAGED_CODE=$(printf '%s\n' "$STAGED_ALL" | \
    grep -v '\.md$' | \
    grep -v '^docs/' || true)

if [ -z "$STAGED_ALL" ]; then
    exit 0
fi

# Allowlist (precommit:allow-*): explicit, auditable exemptions for tokens that
# look like a flagged pattern but are known-safe. A flagged line is cleared ONLY
# if, after masking the allowlisted token(s), the sensitive pattern no longer
# matches — so a real secret sharing a line with an allowed token is never
# hidden. Add one ERE per known-safe case, each with a justifying comment.
#   - oara-prometheus : the project's PyPI *distribution name* (pyproject.toml
#       [project].name and uv.lock), NOT an "OAra-*" infrastructure hostname.
#       No real OAra host contains "prometheus", so masking it cannot hide one.
ALLOWLIST_REGEX='oara-prometheus'

# Obvious non-secrets: test fixtures and doc placeholders. A real leaked
# credential does not have "test"/"fake"/"example" sitting in it. Applied ONLY
# to the credential-shape patterns below (those marked skip_placeholders=1),
# never to the original infrastructure checks, so existing strictness is
# unchanged.
#
# WHY this exemption exists: the repo's own tests legitimately contain
# key-shaped fixtures (`sk-ant-wizard-test-000000`, `xoxb-test-token`). Without
# it, editing any provider test would block the commit — and a hook that cries
# wolf trains you to reach for `--no-verify`, which is strictly worse than a
# hook with one narrow, documented blind spot.
PLACEHOLDER_REGEX='(?i)(test|fake|example|dummy|placeholder|sample|redacted|never|your[-_]?(key|token)|xxxx|0000)'

check_pattern() {
    local label="$1"
    local pattern="$2"
    local skip_placeholders="${3:-0}"
    # scope: "all" (default — includes markdown/docs) or "code" (excludes them)
    local scope="${4:-all}"
    local files="$STAGED_ALL"
    [ "$scope" = "code" ] && files="$STAGED_CODE"

    while IFS= read -r file; do
        [ -f "$file" ] || continue
        # Use git show to read the staged version, not the working copy
        matches=$(git show ":$file" 2>/dev/null | grep -nP "$pattern" || true)
        [ -n "$matches" ] || continue
        while IFS= read -r match; do
            [ -n "$match" ] || continue
            # Mask allowlisted tokens, then re-test: if the sensitive pattern no
            # longer matches, the only hit was an allowlisted false positive.
            stripped=$(printf '%s' "$match" | sed -E "s/${ALLOWLIST_REGEX}//g")
            printf '%s' "$stripped" | grep -qP "$pattern" || continue
            if [ "$skip_placeholders" = "1" ] && \
               printf '%s' "$match" | grep -qP "$PLACEHOLDER_REGEX"; then
                continue
            fi
            echo "  BLOCKED  $file:$match"
            echo "           reason: $label"
            echo ""
            BLOCKED=1
        done <<< "$matches"
    done <<< "$files"
}

echo ""
echo "=== Prometheus pre-commit: scanning staged files ==="
echo ""

# 1. Tailscale private IPs (100.x.x.x)
check_pattern "Tailscale private IP (100.x.x.x)" \
    '100\.[0-9]+\.[0-9]+\.[0-9]+'

# 2. SSH private key material
check_pattern "SSH private key material" \
    'BEGIN (RSA|EC|DSA|OPENSSH) PRIVATE KEY|PRIVATE KEY-----'

# 3. Telegram bot tokens (digits:alphanumeric)
check_pattern "Telegram bot token pattern" \
    '[0-9]{8,}:[A-Za-z0-9_-]{30,}'

# 4. Live/test API keys (sk-live, sk-test, sk_live, sk_test)
check_pattern "API key (sk-live/sk-test/sk_live/sk_test)" \
    'sk[-_](live|test)[_A-Za-z0-9]+'

# 5. Hardcoded SSH key paths to user-specific keys
check_pattern "Hardcoded user SSH key path" \
    '/home/[^/]+/\.ssh/id_'

# 6. OAra machine hostnames (Brain-Node, GPU-Node, etc. — not "OAra Labs"
#    attribution). The "oara-prometheus" distribution name is exempted via
#    ALLOWLIST_REGEX above (a package name, not a host).
check_pattern "Infrastructure hostname (OAra-*)" \
    'OAra-|oara-' 0 code

# ── Credential shapes (added 2026-07-27 after a repo secret audit) ──────────
# GitHub's server-side push protection already blocks most PROVIDER keys, but
# it is the last line, not the first: it fires after you've committed and
# pushed. These catch the same material at commit time, plus the class GitHub
# CANNOT recognise — this project's own opaque tokens (see #8).
#
# All use skip_placeholders=1 so the repo's key-shaped test fixtures don't
# block ordinary work (see PLACEHOLDER_REGEX).

# 7. Provider API keys, by their real prefixes. Length floors are set above the
#    repo's fixture lengths so obvious fakes don't match in the first place.
#
#    2026-08-13 — the sk- branch used to be `sk-[A-Za-z0-9]{32,}`, which demands
#    32 straight alphanumerics right after "sk-". Every SEGMENTED key therefore
#    slipped through, because the second hyphen ends the run after two chars:
#      sk-sp-…  Alibaba Token Plan       MISSED
#      sk-ws-…  Alibaba workspace        MISSED  (a real one was live in the env file)
#      o1_…     plan keys with this prefix        MISSED
#    Only the flat `sk-<32 alnum>` and the explicitly-listed `sk-ant-` matched.
#    The class now allows internal - and _, so any sk-<segment>-<segment> form
#    is covered, including vendors we have not met yet. Verified against the
#    whole tracked tree: no new matches, so this widens coverage without
#    training anyone to reach for --no-verify.
check_pattern "Provider API key (Anthropic/OpenAI/Alibaba/GitHub/Google/xAI/Slack/AWS)" \
    'sk-ant-[A-Za-z0-9_-]{20,}|sk-[A-Za-z0-9_-]{32,}|o1_[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|AIza[A-Za-z0-9_-]{30,}|xai-[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{20,}|AKIA[0-9A-Z]{16}' \
    1

# 7b. Account-identifying provider endpoints. Not a credential, but a hostname
#     that names YOUR tenant: Alibaba Model Studio workspace endpoints embed the
#     workspace id (ws-<id>.<region>.maas.aliyuncs.com). Pattern 6 only knows
#     OAra-* hosts, so these committed clean — and unlike a key you cannot
#     rotate a workspace id.
#
#     Deliberately narrow: it requires a 12+ char opaque id, which every
#     placeholder form fails (ws-<workspace-id>, ws-abc.…example). Shared public
#     hosts — token-plan.…, dashscope-intl.…, coding-intl.… — are NOT tenant
#     identifiers and are not matched. Verified: 0 hits across the tracked tree.
check_pattern "Account-identifying provider endpoint (Alibaba workspace host)" \
    'ws-[a-z0-9]{12,}\.[a-z0-9-]+\.maas\.aliyuncs\.com' \
    1

# 8. THE GAP THIS AUDIT FOUND: Prometheus/OAra issue their own 64-char opaque
#    tokens (PROMETHEUS_API_TOKEN, OARA_API_TOKEN, BRIDGE_BACKEND_TOKEN). They
#    carry no vendor prefix, so they are indistinguishable from random hex to
#    GitHub's provider-pattern scanner — nothing upstream would stop them. Match
#    on the ASSIGNMENT instead: a long opaque value bound to a secret-ish name.
check_pattern "Opaque secret assigned to a credential-named variable" \
    '(?i)(api[_-]?key|api[_-]?token|auth[_-]?token|access[_-]?token|bearer|secret|password|passwd)["'"'"']?\s*[:=]\s*["'"'"']?[A-Za-z0-9+/=_-]{32,}' \
    1

if [ "$BLOCKED" -eq 1 ]; then
    echo "=== COMMIT BLOCKED ==="
    echo ""
    echo "Staged files contain sensitive data that must not be committed."
    echo "Fix the flagged lines above, then re-stage and commit."
    echo ""
    echo "If this is a false positive, you can bypass with:"
    echo "  git commit --no-verify"
    echo ""
    exit 1
fi

echo "All clean. No sensitive data found in staged files."
echo ""
exit 0
