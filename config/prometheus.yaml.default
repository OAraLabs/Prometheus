# Prometheus configuration — reference defaults
# Copy to config/prometheus.yaml and customize (or run `prometheus setup`).
# config/prometheus.yaml is gitignored — your secrets stay local.
#
# CONFIG SEARCH ORDER (first hit wins):
#   1. an explicit --config path
#   2. config/prometheus.yaml          — repo-local (checkout installs)
#   3. $PROMETHEUS_CONFIG_DIR/prometheus.yaml
#      (default ~/.prometheus/prometheus.yaml — pip installs; this is
#       what `prometheus setup --fast` writes)
#
# SECRETS never belong in this file — put them in the env file the daemon
# and the systemd unit both load: ~/.config/prometheus/env
# (PROMETHEUS_API_TOKEN, PROMETHEUS_TELEGRAM_TOKEN, ANTHROPIC_API_KEY, …).

system:
  name: "Prometheus"
  version: "0.1.0"

# Layer 1 Bootstrap — identity files loaded into every system prompt
bootstrap:
  load_soul: true       # ~/.prometheus/SOUL.md
  load_agents: true     # ~/.prometheus/AGENTS.md

model:
  # Env var holding this provider's API key (cloud providers only; local
  # llama_cpp/ollama need none). Read by cli/doctor.py:112.
  api_key_env: ""
  provider: "llama_cpp"             # llama_cpp, ollama, openai, anthropic, gemini, xai,
                                    # deepseek, kimi, glm, mimo
  base_url: "http://localhost:8080" # Inference server URL
  model: ""                         # A HINT, not an assertion. The BACKEND is authoritative:
                                    # whatever llama-server reports from /v1/models wins, and this
                                    # value is used only before the first successful detection and
                                    # when the server is unreachable. Leave blank unless you need a
                                    # name for a backend that cannot be asked.
                                    #
                                    # Precedent, and the reason this is worth stating: the daemon
                                    # ALREADY treats the backend as truth for the context WINDOW —
                                    # the server-reported n_ctx overrides effective_limit (see
                                    # context/budget.py). That mechanism was simply never applied to
                                    # the model's IDENTITY, so the same daemon believed the server
                                    # about how big the window is and the config about what was
                                    # answering. A pin held "gemma4-26b" here while the rig served
                                    # Qwen for six weeks, silently.
  # Where a turn goes when THIS provider fails terminally — an expired key, a revoked
  # credential, a billing lapse. Never on a 429: rate limits are already retried with backoff
  # a layer down, and degrading on one would abandon a provider that was about to succeed.
  #
  # Omit the section and the local model config above IS the target. Set `enabled: false` to
  # turn the whole mechanism off and let a terminal failure end the turn — which is what coding
  # mode wants, since it pins its provider so the acceptance metric is not confounded.
  #
  # The degrade is LOUD: the reply says which model served it and why. And a turn that will not
  # fit the fallback's context window is REFUSED with both numbers rather than quietly
  # truncated — the local backend publishes ~32k while a cloud model may be an order of
  # magnitude larger, so a silent swap makes answers worse with no stated cause.
  fallback:
    enabled: true
    # provider: "llama_cpp"          # defaults to the model config above
    # model: ""                      # defaults to the model config above
    # base_url: "http://localhost:8080"

  identity_probe_interval_seconds: 300  # Re-ask the backend which model it is serving (0 = off).
                                    # Detection used to run ONCE at boot, so swapping the model on
                                    # the server left the label wrong until the next restart. Every
                                    # observed disagreement logs a WARNING — not just the first,
                                    # deliberately: a warning that fires once is one you scroll past.
  grammar_enforcement: true             # GBNF constrained decoding for llama.cpp tool calls
  # suppress_thinking: true             # UNSET defaults to true: send chat_template_kwargs.thinking=false
                                        # every turn so the model's reasoning channel stays OFF (keeps
                                        # gemma4-26b from burning its budget thinking + emitting empty
                                        # content). Set false to ENABLE thinking on agent turns — only
                                        # with a server-side llama.cpp --reasoning-budget in place, or
                                        # unbounded thinking can exhaust the budget. (2026-06-11 bakeoff:
                                        # the openhands arm ran thinking-on; this knob lets Prometheus match.)
  #
  # Both kwargs go out every turn — `thinking` (gemma's templates) AND
  # `enable_thinking` (Qwen's) — because the key a template honours is a
  # property of the MODEL, not of the setting.
  verify_thinking_suppression: warn     # warn | refuse | off. Absent == "warn", so this
                                        # line is documentation, not a behaviour change.
                                        # The knob above is a chat-template kwarg, and a template that does
                                        # not recognise the key IGNORES IT IN SILENCE: 200 OK, a normal-looking
                                        # completion, and the reasoning channel still running and still eating
                                        # the output budget. Whether it works was readable from NOTHING — not
                                        # the code, not this file, not the logs — and on 2026-08-17 that gap
                                        # produced a confident wrong root-cause report.
                                        # So the daemon MEASURES it at boot: two ~30-token completions built by
                                        # the real payload builder (one suppressed, one control), and it logs
                                        # supported / unsupported / moot / unknown. A failed probe is "unknown",
                                        # never a pass. "refuse" turns an unsupported model into a startup
                                        # failure; "off" skips the probe entirely.
  # Backstop ONLY — progress, not round count, is what stops a stuck turn
  # (the repeat detector halts unproductive repetition at 3). Raised 25->500
  # with #263: of 38 recorded cap hits, 24 were productive runs cut off
  # mid-task. Must match the code default in config/shipped_defaults.py.
  #
  # NOTE the cloud cap is now BELOW the local one, reversing the old ordering.
  # Deliberate: cloud rounds cost money per call, local rounds cost only
  # wall-clock on hardware already paid for. See shipped_defaults.py for the
  # recorded risk — local is also the path likeliest to produce the
  # varied-argument flail the repeat detector cannot see.
  max_tool_iterations: 500              # Max tool calls per user message before hard stop (local/llama)
  max_tool_iterations_cloud: 100        # Separate, LOWER cap for cloud (tier=off): every round is billed
  fallback_provider: "ollama"
  fallback_url: "http://localhost:11434"

# Assembly-time context compaction (the relief valve). Sprint 2 (OAra):
# this was config-dark since birth — the compactor only exists when
# compaction.enabled is true. Default ON; the config-dark audit alarms if
# an expected-enabled compactor is missing from /api/status.
compaction:
  enabled: true

  # ── Previously undocumented: read by the code, absent from this
  #    template. Values are the CODE'S OWN FALLBACK, so writing them
  #    changes nothing — they only make the existing behaviour visible.
  #    Pinned equal to the readers by tests/test_config_defaults_equality.
  max_summary_tokens: 512
  protect_recent_turns: 8
  reserve_tokens: 4096
  threshold_pct: 0.75

context:
  effective_limit: 24000
  compression_trigger: 0.75
  tool_result_max: 4000
  tool_results_turn_budget: 8000            # max tokens across all results per turn
  reserved_output: 2000
  fresh_tail_count: 32
  microcompact_after_turns: 3               # compact tool results older than N turns
  microcompact_keep_chars: 200
  microcompact_keep_chars_no_lcm: 500

  # Per-model context ceilings. Keys are model names as reported by the
  # provider; each carries an effective_limit in tokens.
  # Budget for a session routed to a CLOUD provider (/claude, /qwen, …) when
  # the model has no entry in model_overrides below.
  #
  # Local models need nothing here — the daemon reads n_ctx from the
  # inference server at startup and uses it, so swapping a GGUF needs no
  # config change. Cloud providers do NOT publish context length through
  # their APIs (Alibaba's /v1/models returns only id/object/created/owned_by,
  # and the others are the same), so this is an assumption, deliberately a
  # generous one: over-budgeting cloud fails LOUD (a 400 naming the real
  # limit) while under-budgeting fails SILENT (early compaction quietly
  # summarising context that did not need it).
  cloud_default_limit: 1000000

  # Per-model context windows, by EXACT model name. Only needed for models
  # whose window differs from the rules above — i.e. cloud models materially
  # SMALLER than cloud_default_limit. Example:
  #
  #   model_overrides:
  #     claude-sonnet-4-5:
  #       effective_limit: 200000
  #     gpt-4o:
  #       effective_limit: 128000
  model_overrides: {}

  # ── Previously undocumented: read by the code, absent from this
  #    template. Values are the CODE'S OWN FALLBACK, so writing them
  #    changes nothing — they only make the existing behaviour visible.
  #    Pinned equal to the readers by tests/test_config_defaults_equality.
  microcompact_on_cloud: false
  project_file_max_chars: 12000
  stack_project_files: true
tools:
  deferred_loading:
    # Tri-state: true | false | auto (default). "auto" resolves at run start —
    # enabled on local backends (llama.cpp/Ollama tiers, where ~8k tokens of
    # schemas crowd a small window and fewer tools help small-model calling),
    # disabled on cloud API providers (big windows + prefix caching make the
    # full stable catalog cheap). Explicit true/false always wins. The
    # advertised set is frozen per run either way.
    enabled: auto
    # web_search/web_fetch/memory promoted 2026-08-11 (promotion review):
    # "look that up", a bare URL, or "remember that I…" give the model no
    # signal to search its own tool list — the web pair had 180 real calls
    # through 07-25 and ZERO from the day deferral activated. ~670 est
    # tokens buys the class out; the advertised set stays ~74% below the
    # full catalog.
    always_loaded: [bash, task_create, read_file, write_file, edit_file, grep, glob, tool_search, web_search, web_fetch, memory]
    mcp_always_deferred: true
    search_mcp: true

adapter:
  adaptive_strictness: false                # auto-tune per-tool strictness from telemetry
  strictness_window: 100
  strictness_threshold: 0.8

  # ── Previously undocumented: read by the code, absent from this
  #    template. Values are the CODE'S OWN FALLBACK, so writing them
  #    changes nothing — they only make the existing behaviour visible.
  #    Pinned equal to the readers by tests/test_config_defaults_equality.
  unwrap_dict_args:            # required — no code default

security:
  permission_mode: "default"
  # Where write_file / edit_file may write WITHOUT asking. Accepts one path or
  # a list of them. Ships tight — widen deliberately (e.g. "~/projects") if
  # you want the agent working across your own directories. Coding runs,
  # documents and the artifact outbox have their own confinement and are not
  # limited by this.
  #
  # ⚠ THIS IS A SPEED BUMP, NOT CONFINEMENT. It gates write_file and edit_file
  # only. `bash` is checked on its COMMAND STRING and its own working
  # directory, never on the paths a command writes to, so
  # `echo x > /anywhere/file` is not stopped by this key — and a model refused
  # by write_file will reach for bash unprompted; observed doing exactly that,
  # and saying so, on 2026-08-13. What it buys is that an ACCIDENTAL write
  # outside your working area asks first. For anything that must never be
  # written, use denied_paths below — that one is a refusal.
  workspace_root: "~/.prometheus/workspace"
  denied_commands:
    - "rm -rf /"
    - "rm -rf ~"
    - "DROP TABLE"
    - "mkfs"
  # Paths the agent may never read or write. ABSOLUTE ONLY — an entry that is
  # not absolute (or ~-rooted) raises at startup rather than being resolved,
  # because a relative entry resolves against the DAEMON'S WORKING DIRECTORY,
  # so the file it protects moves when the process does. That is not a
  # control; it is a control-shaped thing. (Proven 2026-08-13: moving the
  # daemon to a deploy clone silently moved "config/prometheus.yaml" off the
  # file it was meant to protect, and nothing announced it.)
  #
  # `*`, `?` and `[...]` are supported and match across `/` — broader than a
  # shell glob, deliberately, because this is a DENY list.
  #
  # The daemon's own config file is denied AUTOMATICALLY from the path it was
  # actually loaded from — no entry needed, and no template can name an
  # absolute path that is right for every install.
  denied_paths:
    - "/etc"
    - "/sys"
    - "/boot"
    # ANY home, not just the daemon's. These were "~/.ssh" etc, and "~"
    # expands to whoever the daemon runs as — so /root/.ssh and any other
    # user's keys were ALLOWED by the gate, held back only by OS permissions.
    # fnmatch's "*" spans "/" in denied_paths, deliberately: broader means
    # more denied, and this is a deny list.
    - "/*/.ssh"
    - "/*/.gnupg"           # GPG keys — the sibling of .ssh
    - "/*/.config/*/*env"   # credential env files (…/prometheus/env, …/oara/middleware.env)
  # THE ABOVE DOES NOT COVER bash. denied_paths is only consulted when a call
  # passes a file_path, and bash is handed a command string — so at BOTH
  # origins `cat ~/.ssh/id_*` is ALLOW. Measured, not inferred. Any check on
  # the command string is defeated by ordinary shell (`cd ~/.ssh && cat id_*`,
  # $HOME indirection, globs, sh -c), so the floor for bash is enforced by the
  # kernel instead:
  #
  #   off       (default) no kernel floor for bash. The three patterns above
  #             protect the path-declaring tools ONLY.
  #   required  every bash call execs through `aa-exec -p prometheus-bash`.
  #             If the profile is not loaded, or aa-exec is missing, or the
  #             transition does not happen, bash REFUSES TO RUN and says so —
  #             it never silently falls back to an unconfined shell.
  #
  # Default is off because Prometheus runs on hosts without AppArmor, where
  # "required" would refuse every bash call. Turning it on is a deliberate act.
  # Profile ships at deploy/apparmor/prometheus-bash; load it with:
  #   sudo apparmor_parser -r -W /etc/apparmor.d/prometheus-bash
  bash_confinement: "off"
  # Regexes auto-ALLOWed even at SYSTEM trust (background tasks / cron) so a
  # vetted long-running job can run without a human approver. Evaluated AFTER
  # the denied/always-blocked/exfiltration gates (cannot resurrect a block) and
  # refused if the command contains chaining metachars (; & | ` $()). Keep each
  # pattern as narrow as possible — anchor the host, the destination, and the
  # source. Example: download ONE Hugging Face .gguf onto the GPU box's models
  # dir (powers the download-model-to-gpu skill). Replace the login with yours.
  # allowed_commands:
  #   - ^ssh\s+<user>@<gpu-host>\s+'wget\s+[^']*-O\s+~/models/[^']*\.gguf\s+https://huggingface\.co/[^']*\.gguf'\s*$
  audit:
    enabled: true
    retention_days: 30
  exfiltration:
    enabled: true
  approval_queue:
    enabled: false
    timeout_seconds: 1800            # 30 min — a phone notification is not answered in 5

  allowed_commands: []
infrastructure:
  archive_enabled: true
  telemetry_enabled: true

  # Local topology. Values are machine-specific and MUST stay in the live
  # config only — the pre-commit hook blocks real hosts/IPs in this template.
  gpu_host: ""
  mini_host: ""
  mini_port: 8005
gateway:
  telegram_enabled: false
  telegram_token: ""                # Set via PROMETHEUS_TELEGRAM_TOKEN env var
  allowed_chat_ids: []
  proxy_url: null
  heartbeat_interval: 30
  cron_enabled: true
  # Sprint S1: user-visible signals (skill_created / skill_refined /
  # memory_updated / curator_report) post a short notification to the
  # last active Telegram chat. Modes: off | quiet | verbose.
  # `/notifications <mode>` toggles at runtime (Stream 3).
  skill_event_notifications: quiet
  telegram:
    # How often to ask Telegram whether it is actually answering (0 disables).
    #
    # The adapter's `running` flag is SELF-REPORTED: start() sets it, stop()
    # clears it, and nothing in between consults Telegram. On 2026-08-15 it
    # read healthy for 45 minutes while every call returned 502 and no
    # inbound message arrived. python-telegram-bot cannot raise the alarm
    # either — httpx times out at 5s, Telegram's 502 took ~15.7s, and the
    # resulting TimedOut is the one branch of its retry loop that skips the
    # error callback and logs at DEBUG.
    #
    # So this probe is the only thing that can tell you the gateway is dark.
    # Result surfaces as `gateway.reachable` on /api/status and
    # `gateway_reachable` in the heartbeat. Transitions log; steady state is
    # quiet, so the cost of the default is one getMe per minute.
    probe_interval_seconds: 60
  media:
    max_file_size_mb: 20
    cache_dir: "~/.prometheus/cache/media"
    # ENFORCED since PR #140 (was inert before it). Empty list = no restriction
    # for that kind. Telegram is the one surface exposed to the public internet
    # by design, so these are real controls, not documentation.
    #
    # ⚠ Two rules learned the hard way — see tests/test_media_admission.py,
    # which asserts a legitimate file of EVERY type below is actually ADMITTED:
    #   1. A type here must be spelled as the sniffer/declarer produces it.
    #      "audio/mp3" looks right and is wrong — real MP3s are "audio/mpeg",
    #      so that entry silently refused every MP3.
    #   2. allowed_document_types must AGREE with the extension gate
    #      (SUPPORTED_DOCUMENT_TYPES in gateway/media_cache.py). When the gate
    #      advertised 20 types and this list named 3, the other 17 passed the
    #      gate and were rejected here. A test pins the two together.
    allowed_image_types:
      - image/jpeg
      - image/png
      - image/gif
      - image/webp
    allowed_audio_types:
      - audio/ogg
      - audio/mpeg   # NOT audio/mp3 — that is what the signature table emits
      - audio/wav
    allowed_document_types:
      - application/pdf
      - text/plain
      - text/markdown
      - text/csv
      - text/html
      - text/javascript
      - text/x-python
      - text/x-shellscript
      - text/typescript
      - application/json
      - application/sql
      - application/toml
      - application/xml
      - application/x-yaml
    # Cache quota + free-disk floor. CONVENIENCE guards (see gateway.guards):
    # they fail OPEN — below the floor we refuse to CACHE, never to SERVE.
    cache_max_mb: 512
    free_disk_floor_mb: 1024
  rate_limits:
    messages_per_minute: 30
    media_downloads_per_minute: 10
  # Slack gateway (optional extra: pip install 'oara-prometheus[slack]').
  # Socket Mode — needs BOTH tokens: a bot token (xoxb-...) and an app-level
  # token (xapp-...), created at https://api.slack.com/apps. Empty
  # allowed_channels = respond anywhere the bot is invited. (The legacy flat
  # keys slack_enabled / slack_bot_token / slack_app_token / slack_channels
  # still work and win over this nested form when set.)
  slack:
    enabled: false
    bot_token: ""                     # Set via PROMETHEUS_SLACK_BOT_TOKEN env var
    app_token: ""                     # Set via PROMETHEUS_SLACK_APP_TOKEN env var
    allowed_channels: []              # e.g. [C0123456789]

  # SPRINT G2: Discord gateway (optional extra: pip install 'oara-prometheus[discord]').
  # Whitelist semantics: DMs are ALWAYS allowed; guild-channel messages need
  # a channel_ids (per-channel) or guild_ids (whole-guild) hit. With both
  # empty the bot is DMs-only. App commands register guild-scoped (instant)
  # when guild_ids is set, else globally (up to ~1h to propagate Discord-side).
  discord:
    enabled: false
    token: ""                          # Set via PROMETHEUS_DISCORD_TOKEN env var
    guild_ids: []                      # e.g. [123456789012345678]
    channel_ids: []                    # e.g. [987654321098765432]
    skill_event_notifications: quiet   # off | quiet | verbose
    long_reply_threshold: 800          # chars; longer replies open a thread

  # Paperclip fleet orchestration (github.com/paperclipai/paperclip) —
  # Prometheus as a managed "agent employee". In Paperclip, create an agent
  # with adapter type `http`, url http://<this-host>:8005/api/paperclip/wake,
  # and headers {"Authorization": "Bearer <PROMETHEUS_API_TOKEN>"}. Each wake
  # runs the heartbeat protocol (checkout -> agent turn -> status/comment ->
  # cost event) against api_url; work turns appear in Beacon as sessions
  # named paperclip:issue:<id>.
  paperclip:
    enabled: false
    api_url: "http://127.0.0.1:3100"  # Paperclip server base URL
    api_key: ""                       # Set via PROMETHEUS_PAPERCLIP_API_KEY (agent API key;
                                      # empty = Paperclip local trusted mode)
    timeout_seconds: 30               # per Paperclip API call
    comment_max_chars: 4000           # cap on posted progress comments

  # Placeholder only — the real prompt lives in the live config. See docs.
  system_prompt: "# see docs; overridden in live config"
  briefing_chat_id: ""
  voice:
    engine: piper
    default_mode: auto
    max_chars: 800
    model_path: ""
    opus_bitrate: 32k

  # ── Previously undocumented: read by the code, absent from this
  #    template. Values are the CODE'S OWN FALLBACK, so writing them
  #    changes nothing — they only make the existing behaviour visible.
  #    Pinned equal to the readers by tests/test_config_defaults_equality.
  slack_app_token: ''
  slack_bot_token: ''
  slack_channels:            # required — no code default
  slack_enabled: false
whisper:
  enabled: false
  model: "base"
  device: "auto"
  language: "en"

model_router:
  enabled: false

# Sprint 22 GRAFT-ROUTER-WIRE Phase 4 — direct-mode provider overrides.
#
# Lets you switch a single Telegram (or Slack) chat to a different cloud
# provider on the fly:
#   /claude   — route this chat through Anthropic Claude
#   /gpt      — OpenAI GPT
#   /gemini   — Google Gemini
#   /xai      — xAI Grok  (alias: /grok)
#   /local    — clear the override, back to primary
#   /route    — show which provider this chat is currently using
#
# Overrides are scoped to the session (Telegram chat_id / Slack channel_id);
# other chats, system paths (evals, benchmarks, smoke tests), and SENTINEL
# are unaffected.
#
# Requires the target provider's API key in the environment (e.g.
# ANTHROPIC_API_KEY for /claude). Add the key to ~/.config/prometheus/env
# and restart the daemon.
router:
  overrides:
    enabled: true          # direct-mode commands are active
    sticky: true           # overrides persist until /local (false = one-shot)
  fallback: []

  # ── Previously undocumented: read by the code, absent from this
  #    template. Values are the CODE'S OWN FALLBACK, so writing them
  #    changes nothing — they only make the existing behaviour visible.
  #    Pinned equal to the readers by tests/test_config_defaults_equality.
  auxiliary:
    compression:            # required — no code default
    summarization:            # required — no code default
    vision:            # required — no code default
  escalation:
    as_subagent: true
    budget_usd: 1.0
    enabled: false
    provider:            # required — no code default
  rules: []
  smart_routing:
    enabled: false
    max_simple_chars: 160
    max_simple_words: 28
    simple_provider:            # required — no code default

# Per-slash-command model selection.
#
# Each /claude /gpt /gemini /xai command in Telegram (and /grok as a /xai
# alias) uses the provider + model below. If you omit this section, or omit
# a specific command, the daemon falls back to the built-in default
# (logged as WARN once at first use) — the defaults are conservative
# (cheap/fast) and listed in src/prometheus/router/model_router.py
# under OVERRIDE_PRESETS.
#
# Model field accepts either a provider alias (e.g. claude-sonnet-4-5,
# claude-haiku-4-5) or a fully pinned snapshot ID
# (claude-sonnet-4-5-20250929). Anthropic pre-4.6 aliases resolve
# server-side; 4.6+ IDs are already dateless pinned snapshots. For
# OpenAI / Gemini / xAI use the model name the provider exposes
# (e.g. gpt-4o, gemini-2.5-pro, grok-4.5).
#
# After editing, restart the daemon and grep journalctl for "slash_commands"
# to verify the wiring:
#   journalctl --user -u prometheus.service | grep slash_commands
slash_commands:
  claude:
    provider: anthropic
    api_key_env: ANTHROPIC_API_KEY
    model: claude-haiku-4-5    # cheap + fast default; user pins heavier model
  gpt:
    provider: openai
    api_key_env: OPENAI_API_KEY
    model: gpt-4o
  gemini:
    provider: gemini
    api_key_env: GEMINI_API_KEY
    model: gemini-2.5-flash
  xai:
    provider: xai
    api_key_env: XAI_API_KEY
    model: grok-4.5    # request EXPLICITLY: grok-3/grok-4 aliases serve grok-4.3
  # CLOUD EXPANSION (2026-07) — /deepseek /kimi /glm /mimo. Same rules as
  # above: the command only works once the key env var is in
  # ~/.config/prometheus/env and the daemon has been restarted.
  deepseek:
    provider: deepseek
    api_key_env: DEEPSEEK_API_KEY
    model: deepseek-v4-flash   # reasoning flagship: deepseek-v4-pro
                               # (deepseek-chat/-reasoner aliases deprecated 2026-07-24)
  kimi:
    provider: kimi
    api_key_env: MOONSHOT_API_KEY
    model: kimi-k2.6
  glm:
    provider: glm
    api_key_env: ZAI_API_KEY
    model: glm-5.2
  mimo:
    provider: mimo
    api_key_env: MIMO_API_KEY
    model: mimo-v2.5-pro

# Phase 3 — opt-in cloud escalation for failed tool calls.
#
# When a tool call fails validation more times than the adapter's max_retries,
# the main agent normally aborts. With escalation enabled, the retry engine
# instead spawns a subagent running on a stronger provider (e.g. Claude,
# GPT, Grok) to attempt the same tool call, and feeds the result back as a
# tool_result. The main agent keeps running on the primary provider — only
# the single failing tool call is delegated.
#
# Default: disabled. Uncomment and fill in an api_key_env to enable.
#
# router:
#   escalation:
#     enabled: false
#     provider:
#       provider: anthropic            # anthropic | openai | gemini | xai
#       api_key_env: ANTHROPIC_API_KEY
#       model: claude-sonnet-4-6
#     as_subagent: true                # use isolated SubagentSpawner (recommended)
#     budget_usd: 1.00                 # soft cost cap per escalation (future enforcement)

# Divergence detection — OBSERVATIONAL. Every `checkpoint_interval` tool
# calls the agent's message history is snapshotted into the `checkpoints`
# table in lcm.db, and a drift score is computed from goal alignment, tool
# failure rate and repetition. Crossing `threshold` logs a WARNING naming
# the task. Nothing is rolled back and no turn is altered.
#
# FL-4 retired the rollback half rather than finish it: it was broken in
# three further places beyond the missing start_task call, and the scoring
# heuristic has never run in production. `max_rollbacks` and
# `auto_rollback_trust_level` are gone — they are no longer read anywhere in
# src/, and a key with no reader is a config that documents fiction.
# `use_llm_eval` / `llm_eval_budget` went with them: they described an
# LLM-backed evaluator nobody built.
divergence:
  enabled: false

  threshold: 0.7
  checkpoint_interval: 5
learning:
  # PeriodicNudge — self-reflection prompt every N agent turns.
  nudge_enabled: true
  nudge_interval: 15
  # SkillCreator — auto-generate SKILL.md from successful tool traces.
  auto_skill_creation: true
  skill_min_tool_calls: 3
  # SkillRefiner — refine an existing auto-skill when execution deviates beneficially.
  skill_refinement_enabled: false
  skill_refiner_model: default
  # Curator — periodic consolidation pass over ~/.prometheus/skills/auto/.
  # Stage 1 (auto): flip lifecycle state based on mtime (stale/archived).
  # Stage 2 (LLM): recommend consolidations (report-only) + prunings (applied:
  # file moved to auto/.archive/, NEVER deleted). Pinned skills are protected.
  # Adapted from Hermes agent/curator.py (see prometheus/learning/curator.py).
  curator_enabled: true
  curator_interval_seconds: 604800        # 7 days
  curator_stale_after_days: 30            # mtime >= N days → state=stale
  curator_archive_after_days: 90          # mtime >= N days → state=archived
  curator_min_idle_seconds: 0             # 0 = always run on tick (reserved)
  curator_max_prunings_per_run: 10        # safety cap on auto-archives per pass
  curator_telegram_summary: true          # post a one-line summary to Telegram on run
  # GEPA (SUNRISE Session B) — Generalized Evolutionary Prompt Architecture.
  gepa_enabled: false
  gepa_max_skills_per_cycle: 3
  gepa_variants_per_skill: 3
  gepa_min_traces_required: 10
  gepa_judge_threshold: 0.7
  gepa_min_idle_minutes: 10
  gepa_max_frequency_hours: 24
  gepa_model: default
  # Live recorder — "record a skill" from browser demonstration traces.
  # The extension uploads DOM events + screenshots to
  # POST /api/learning/live-upload; a deterministic pipeline (no model)
  # synthesizes a SKILL.md, gated by structural quality checks, persisted
  # through SkillCreator into skills/auto/.
  live_recorder:
    enabled: true
    # Second-pass model review of extracted steps (advisory; blocks only on
    # "poor" quality with critical issues). Skipped gracefully when the
    # model provider is unavailable.
    verify_steps: true
  # Video ingestion — the vision leg of record-a-skill. Screen recordings
  # or YouTube URLs are digested by a vision model and synthesized through
  # the same funnel as DOM recordings, but ALWAYS land as drafts requiring
  # human review in Beacon (two-tier trust). The VLM is a swappable
  # registry entry: vision_model must match a config/model_registry.yaml
  # family whose capabilities.vision.supported is true (run
  # `prometheus bakeoff-vlm` against the annotated corpus before enabling
  # a new model). Runtime deps: ffmpeg (or imageio-ffmpeg); optional:
  # yt-dlp (URLs), faster-whisper (narration), scikit-image (keyframe dedup).
  video_ingest:
    enabled: false
    vision_model:              # same shape as the top-level `model:` block
      provider: llama_cpp
      base_url: "http://localhost:8080"
      model: gemma-4

# Golden-trace export — cloud "teacher" tool calls written as fine-tuning
# JSONL. Incremental: each cycle exports only rows newer than the persisted
# watermark (.export_state.json in output_dir), so the corpus accumulates
# instead of restating itself on every daemon restart. Deleting the watermark
# re-exports from the beginning — duplicates, never gaps.
trajectory_export:
  enabled: false
  interval_seconds: 86400  # 24h
  nightly_limit: 1000      # max traces per cycle; a larger backlog drains over
                           # successive cycles rather than being truncated
  output_dir: "~/.prometheus/trajectories/"
  format: jsonl

# Repair-pair flywheel → ~/.prometheus/data/training.db (see
# learning/pair_capture.py for the pair sources).
training:
  # Local pair sources: adapter repairs, retry-success, self-correction.
  # These only fire when something went WRONG and was then fixed, so a
  # well-behaved model banks nothing — a low count here is not a fault.
  capture_enabled: true
  # Cloud tool calls stored as chosen-only exemplars (rejected NULL) for
  # later distillation against local attempts. DEFAULT OFF: it records what
  # the owner already routes to cloud and never generates traffic of its
  # own, but it does persist tool-call payloads, so it is opt-in.
  cloud_golden_capture: false
  db_path: "~/.prometheus/data/training.db"

coding:
  # MASTER SWITCH — enforced at both entry points: `prometheus code` exits
  # non-zero, and POST /api/code returns 403. Coding runs execute
  # model-authored commands against a clone of your repo, so they are
  # opt-in. (Until 2026-08-15 this key was read by nothing and coding ran
  # regardless of it; if you set it false and relied on that, you were not
  # protected.) The daemon's stale-container cleanup below is housekeeping
  # and runs either way.
  enabled: false                # SPRINT-coding-mode v2: sandboxed iterate-to-green
  # process | bwrap | docker — weakest to strongest; create_sandbox() selects.
  #   process — cwd jail + env scrub. Confines the FILE TOOLS only; a shell
  #             redirect to an absolute path escapes it. Honest default.
  #   bwrap   — kernel mount/pid namespace. Closes that hole. Needs
  #             unprivileged user namespaces (blocked by Ubuntu 24.04's
  #             kernel.apparmor_restrict_unprivileged_userns=1 default).
  #   docker  — container isolation, strongest. Needs a reachable daemon.
  # An unavailable backend RAISES rather than silently degrading: being
  # handed a weaker sandbox than you asked for is the one failure mode you
  # would not notice. Pass allow_fallback=True only if you mean best-effort.
  sandbox_type: process
  sandbox_dir: "~/.prometheus/coding/sandboxes/"
  max_task_duration_minutes: 120
  max_iterations: 50
  network_isolation: false      # bwrap + docker — drop network access
  docker_image: "python:3.12-slim"
  docker_cleanup_max_age_hours: 24
  docker_cleanup_enabled: true  # Remove stale containers on daemon start

symbiote:
  enabled: false                # GRAFT-SYMBIOTE Session A: scout/harvest/graft pipeline
  github_token: null            # Or set via env: PROMETHEUS_GITHUB_TOKEN (never logged)
  language_default: Python
  min_stars_default: 10
  max_repo_size_mb: 100
  file_budget_max: 15
  file_budget_kb: 50
  clone_timeout_seconds: 60
  sandbox_dir: "~/.prometheus/symbiote/sandbox/"
  harvest_dir: "~/.prometheus/symbiote/harvests/"
  sessions_db: "~/.prometheus/symbiote/sessions.db"
  scout_model: default          # Model for query gen + relevance scoring
  harvest_model: default        # Model for file selection + adaptation plan
  # GRAFT-SYMBIOTE Session B: blue-green hot swap with auto-rollback
  morph:
    enabled: false              # Off by default; opt-in per machine
    health_check_timeout_seconds: 60
    health_check_interval_seconds: 5
    consecutive_passes_required: 3
    auto_rollback: true         # Always true in V1 (not configurable)
    daemon_manager: auto        # auto | systemd | pidfile | pkill
    daemon_health_url: null     # Optional HTTP /health endpoint to ping
    candidate_dir: "~/.prometheus/symbiote/candidate/"
    post_mortem_dir: "~/.prometheus/symbiote/post_mortem/"
  backup:
    enabled: true               # BackupVault is independently useful
    vault_root: "~/.prometheus/symbiote/backups"
    max_backups: 10
    include_identity: true      # Backup SOUL.md, AGENTS.md, ANATOMY.md
    include_config: true        # Backup config/prometheus.yaml
    pre_graft_backup: false     # Auto-backup before any graft (off by default)
    exempt_from_retention:
      - symbiote_morph
      - manual
      - pre_restore

sentinel:
  enabled: false
  idle_threshold_minutes: 15
  dream_interval_minutes: 30
  synthesis_enabled: true
  auto_fix_wiki: true
  dream_budget_tokens: 2000
  stale_threshold_days: 90
  confidence_decay_rate: 0.05
  digest_lookback_hours: 24
  nudge_cooldown_minutes: 60

# Passive memory recall (MEMORY-3 follow-up). At the start of every agent
# turn the latest user message is matched (FTS5, any-token) against the
# facts in ~/.prometheus/memory.db, and the best few ride THAT turn's
# system prompt as a "# Recalled memory" section. Request-only: recalled
# facts never enter durable history (the extractor would re-ingest them).
# Fails open — a missing or broken memory.db never blocks a turn. Applies
# to the chat surfaces (Telegram/Slack/Discord/web/CLI); coding mode, gym,
# and evals never recall.
memory:
  recall:
    enabled: true
    max_facts: 6          # hard cap on facts injected per turn
    max_chars: 900        # hard cap on the rendered block, preamble included
    min_confidence: 0.6   # ignore low-confidence extracted facts

# Beacon dashboard + REST/WS control plane. ON by default (Onboarding
# Phase 0): the daemon mints a PROMETHEUS_API_TOKEN into the env file on
# first start if none is set, so on-by-default is not open-by-default.
# Set an explicit empty PROMETHEUS_API_TOKEN= in the env file to run
# deliberately open (localhost-only recommended).
web:
  enabled: true
  api_port: 8005
  ws_port: 8010

# Image generation — the image_generate tool's backend selection + per-backend
# settings. CLOUD EXPANSION (2026-07) adds the PAID DashScope backend (WAN 2.5).
#
# HARD RULE: `auto` NEVER silently selects the paid API. auto = probe local
# ComfyUI, fall back to free Pollinations. DashScope runs ONLY when the agent
# passes backend=dashscope explicitly, or when you deliberately set
# default_backend: dashscope below.

  # ── Previously undocumented: read by the code, absent from this
  #    template. Values are the CODE'S OWN FALLBACK, so writing them
  #    changes nothing — they only make the existing behaviour visible.
  #    Pinned equal to the readers by tests/test_config_defaults_equality.
  api_token:            # required — no code default
  dashboard_port: 3002

# APNs push to enrolled devices (GRAFT-MOBILE-BRIDGE 2). Disabled by default:
# enabling requires the `push` extra (pip install 'oara-prometheus[push]')
# and an Apple p8 signing key — an enabled-but-broken block FAILS THE BOOT
# loudly rather than silently pushing nothing. approval_pending pushes
# always; turn/task completions push only to devices with no live WS client.
push:
  enabled: false
  apns:
    key_path:           # e.g. ~/.config/prometheus/AuthKey_XXXXXXXXXX.p8
    key_id:             # the 10-char key id from the Apple developer portal
    team_id:            # e.g. 53JM8W47RL
    topic:              # the app's bundle id, e.g. com.oaralabs.beacon
image_generation:
  default_backend: auto              # auto | pollinations | comfyui | dashscope
  comfyui:
    base_url: "http://127.0.0.1:8188"
    default_model: "flux1-schnell-fp8.safetensors"
    default_steps: 4
  # WAN 2.5 text-to-image via Alibaba DashScope (async task API; PAID).
  # Key: DASHSCOPE_API_KEY in ~/.config/prometheus/env
  # (console: https://dashscope.console.aliyun.com / modelstudio intl).
  dashscope:
    api_key_env: DASHSCOPE_API_KEY
    model: "wan2.5-t2i-preview"
    # Legacy-but-working international default. Newer workspace-scoped
    # DashScope domains exist — override here if your account uses one.
    base_url: "https://dashscope-intl.aliyuncs.com/api/v1"

# Video generation — the video_generate tool (Kling 3.0). PAID; dormant until
# both keys are set. Auth is an AccessKey+SecretKey pair; the tool self-signs
# a short-lived JWT (HS256) per request — keys never leave this machine.
# Console: https://app.klingai.com (API access).
video_generation:
  kling:
    access_key_env: KLING_ACCESS_KEY
    secret_key_env: KLING_SECRET_KEY
    base_url: "https://api-singapore.klingai.com"
    model_name: "kling-v3"
    poll_budget_seconds: 600           # videos take MINUTES; poll every ~10s

# Core web research tools — web_fetch, web_search, youtube_transcript, download_file
web_tools:
  fetch_timeout_seconds: 30                 # web_fetch HTTP timeout
  fetch_max_chars: 8000                     # web_fetch default truncation limit
  search_max_results: 8                     # web_search default result count
  download_dir: "~/.prometheus/downloads"   # download_file default destination
  download_max_mb: 100                      # download_file size cap (MB)
  youtube_transcript_language: "en"         # youtube_transcript default language code

# Printing Press CLI library — discover and install Go-based service CLIs
# from a local clone of github.com/mvanhorn/printing-press-library
printing_press:
  enabled: false                            # opt-in
  library_path: null                        # auto-detect ~/printing-press-library/ → /tmp/printing-press-library/
  auto_suggest: true                        # suggest install on `command not found` (user-initiated only)
  auto_update_library: false                # git pull library on daemon startup

lsp:
  enabled: false

  auto_diagnostics: true
  diagnostics_delay_ms: 500
  servers: {}
profiles:
  default: "full"
  custom_dir: "~/.prometheus/profiles"

anatomy:
  enabled: true
  scan_on_startup: true

  include_in_system_prompt: true
  # Local infrastructure identity. Values are machine-specific and MUST stay
  # in the live config only — the pre-commit hook blocks real hosts/IPs here.
  ssh_user: ""
  ssh_key: ""
# Third-party tools arrive here (FOUNDATION 2.3a) — an MCP server per key.
# Per-server keys: command/args/env/cwd (stdio), connectionTimeoutMs, and
# allowed_tools — an optional allowlist naming the tools to accept from the
# server; everything else it offers is excluded at discovery AND refused at
# call time. Without it every offered tool loads. NOTE: this is an open map
# the config-drift ratchet cannot see into, so a key here is only real if
# code reads it — allowed_tools is read in mcp/runtime.py.
# Example:
#   mcp_servers:
#     context7:
#       command: npx
#       args: [-y, '@upstash/context7-mcp']
#       allowed_tools: [resolve-library-id, get-library-docs]
mcp_servers: {}

# H3: lifecycle hooks. Empty by default (no hooks run). Each event maps to a
# list of hook definitions; supported types: command, http, prompt, agent.
# Example:
#   hooks:
#     pre_tool_use:
#       - type: command
#         command: "echo checking $ARGUMENTS"   # $ARGUMENTS = JSON payload
#         block_on_failure: false               # true = a nonzero exit blocks the tool
#     post_tool_use:
#       - type: http
#         url: "http://localhost:9090/hook"
  # Each entry is a server name -> {command, args, connectionTimeoutMs}.
  # Populated in the live config; empty here.
hooks: {}

evals:
  results_dir: "~/.prometheus/eval_results"
  skip_network_tasks: true
  # Judge independence: with no judge_base_url the LLM judge auto-detects the
  # SAME endpoint the main model uses — i.e. the model grades itself. Fine for
  # smoke checks; for scores you intend to compare or publish, point the judge
  # at a different model. Any OpenAI-compatible server with structured-output
  # support works (llama.cpp, Ollama).
  # judge_model pins WHICH model grades. Without it the judge calls
  # /v1/models on judge_base_url and grades with whatever is loaded —
  # non-deterministic, and self-judging when the two endpoints coincide.
  judge_base_url: http://localhost:11434
  judge_model: qwen2.5:7b-instruct
tracing:
  enabled: false
  service_name: prometheus
  phoenix_endpoint: http://127.0.0.1:6006

# ── Wiki ──────────────────────────────────────────────────────────────────
# Where the compiled wiki lives. Every consumer — the compiler, the linter,
# the knowledge synthesizer, the wiki_query tool, the web bridge and the
# Telegram surfaces — resolves this one key.
# Default: <config dir>/wiki  (i.e. ~/.prometheus/wiki unless
# PROMETHEUS_CONFIG_DIR is set). The PROMETHEUS_WIKI env var overrides the
# default but is itself overridden by this key; scripts/install_obsidian_view.sh
# reads that env var as the shell mirror of this setting.
wiki:
  root: ~/.prometheus/wiki

# ── Brain vault ───────────────────────────────────────────────────────────
# The brain-vault second brain: a git repo of knowledge compiled from the full
# claude.ai + Claude Code history. Prometheus reads it and NEVER writes to it
# (vault_search / vault_read); the vault's own BRAIN.md §1 zone rules make
# that binding, not optional.
#
# This is a SEPARATE root from `wiki:` above. That one is the Prometheus wiki,
# a machine-owned projection of memory.db; this one is hand- and
# ingest-compiled and is not Prometheus's to regenerate. Do not point them at
# the same path — the daemon logs a warning if you do.
#
# Not to be confused with `symbiote.backup.vault_root`, which is snapshot
# storage and unrelated. Everything user-facing about THIS one says
# "brain vault".
#
# The default below is a GENERIC placeholder, not anyone's real vault. Point it
# at yours in the live config (config/prometheus.yaml, which is gitignored) or
# via PROMETHEUS_VAULT in the systemd EnvironmentFile — the same place tokens
# live. This repo is public, so a real vault path does not belong in a tracked
# file; the pre-commit hook enforces that and is right to.
#
# An absent vault is not an error at startup: the tools report it clearly when
# called, naming the resolved path and this key.
vault:
  root: ~/brain-vault
  # Startup handling of the vault's .prometheus-vault format marker when the
  # vault EXISTS but carries no marker yet (a vault from before markers):
  # off = skip the check entirely; warn = log and continue, naming
  # `prometheus vault adopt`; refuse = do not start until adopted. The
  # default is warn for this release so existing vaults keep booting; it
  # will become refuse once adoption is routine. A marker whose format is
  # NEWER than this build refuses regardless of this setting — that is the
  # silent-misread case the marker exists for, and it is not configurable.
  format_check: warn


# ── Doctor ────────────────────────────────────────────────────────────────
doctor:
  startup_check: true
  registry_file: config/model_registry.yaml

# ── Managed tasks ─────────────────────────────────────────────────────────
tasks:
  enabled: true
  default_timeout_seconds: 3600
  poll_initial_interval_seconds: 5
  poll_max_interval_seconds: 120
  reengage_turn_cap: 3

# ── Heartbeat ─────────────────────────────────────────────────────────────
heartbeat:
  # Optional path to a SQLite file carrying a single-row
  # maintenance(until_ts) table. While until_ts is in the future, the
  # "merged-but-dark" drift nudge is suppressed — the merge-to-restart gap is
  # exactly when drift is EXPECTED, and every deploy was generating one.
  #
  # Empty = feature off, behaviour unchanged. Fails OPEN: if the window cannot
  # be read the nudge is NOT suppressed, because swallowing a drift alert is
  # worse than a redundant one.
  #
  # Suppression deliberately does not mark the drift as notified, so when the
  # window closes an un-restarted merge nudges normally rather than being
  # silenced forever.
  maintenance_db: ""

# ── Previously undocumented section: every key below is read by the
#    code and appeared nowhere in this file, so an operator reading the
#    template could not learn the feature existed. Values are the code's
#    own fallbacks — writing them changes nothing.
documents:
  root:            # required — no code default


# ── Previously undocumented section: every key below is read by the
#    code and appeared nowhere in this file, so an operator reading the
#    template could not learn the feature existed. Values are the code's
#    own fallbacks — writing them changes nothing.
escalation:
  api_key_env:            # required — no code default
  max_per_session: 3
  max_tokens: 4096
  teacher_model:            # required — no code default
  teacher_provider: anthropic
