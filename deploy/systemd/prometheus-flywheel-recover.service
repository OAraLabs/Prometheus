# Runs when prometheus-flywheel-weekly.service fails or is killed (OnFailure=).
#
# It does two things and nothing clever: restores the `business` GPU setup if
# the weekly run recorded a swap it did not undo, and, when the run died
# before writing its report, writes LATEST.md saying the window failed and
# which stages it had finished. It retries nothing. When another run still
# holds the flywheel lock (a weekly start that found it busy exits 3, which
# also lands here), it does nothing: that run restores its own swap.

[Unit]
Description=Prometheus fine-tuning flywheel (recovery after a failed weekly run)

[Service]
Type=oneshot
WorkingDirectory=%h/prometheus-build/Prometheus
ExecStart=%h/prometheus-build/Prometheus/.venv/bin/python -m prometheus.jobs.flywheel_weekly --recover
TimeoutStartSec=45min
Environment=PROMETHEUS_CONFIG_DIR=%h/.prometheus
Environment=PROMETHEUS_DATA_DIR=%h/.prometheus/data
Environment=PROMETHEUS_LOGS_DIR=%h/.prometheus/logs
Environment=PYTHONNOUSERSITE=1
