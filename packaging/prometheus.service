# Prometheus daemon — systemd user unit.
#
# Installed by `prometheus install-service`, which resolves the absolute
# path of the installed `prometheus` binary into ExecStart. This copy is
# the shipped default (PATH-resolved fallback).
#
#   prometheus install-service          # write + daemon-reload + enable
#   systemctl --user start prometheus   # start it now
#   journalctl --user -u prometheus -f  # follow the logs

[Unit]
Description=Prometheus AI Agent Daemon
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/env oara daemon
ExecStop=/bin/kill -SIGTERM $MAINPID
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# The env file (~/.config/prometheus/env, written by `prometheus setup` /
# `prometheus token rotate`) is NOT passed with EnvironmentFile=. The daemon
# reads it itself at startup (config/env_file.load_env_file), so the API
# token, gateway tokens and provider credentials reach the daemon, its child
# processes and its scheduled jobs exactly as before — but they are not part
# of the environment the service process is started with. The macOS launcher
# has always loaded it this way; this makes the two match.

[Install]
WantedBy=default.target
